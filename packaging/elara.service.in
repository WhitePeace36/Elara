[Unit]
Description=elara adaptive Linux scheduler (sched_ext)
After=multi-user.target
ConditionPathExists=/sys/kernel/sched_ext
# Only one sched_ext scheduler can be loaded at a time. No Conflicts= with the
# services of the scx schedulers (scx.service, scx_loader.service): systemd
# then stops elara whenever one of them starts, and scx_loader.service is
# started over D-Bus by anything that asks it something (scxctl, the CachyOS
# Kernel Manager), also when it is disabled, without loading a scheduler.
# elara stayed stopped after that (a stop by systemd is no failure to restart
# after). A scheduler one of them tries to load while elara runs fails to
# load; stop elara first. Started at boot, elara comes after them.
After=scx.service scx_loader.service
# A scheduler loaded another way (started by hand) keeps elara from loading:
# it tries again every 5s, up to 30 times in 5 minutes.
StartLimitIntervalSec=300
StartLimitBurst=30

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/elara
Restart=on-failure
RestartSec=5
# Exit status 2: the kernel stopped elara for an error (a stall found by the
# sched_ext watchdog, a runtime error). Loaded again it would likely end the
# same way, so it stays stopped until it is started by hand or the next boot.
# (Stopped by SysRq-S it exits with 0 and isn't restarted either.)
RestartPreventExitStatus=2

[Install]
WantedBy=multi-user.target
